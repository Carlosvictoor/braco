PORT=3000
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Mude para true SOMENTE depois de configurar HTTPS (domínio + certificado com Certbot).
# Antes disso, deixe "false" - senão o cookie de login não funciona.
COOKIE_SECURE=false

# Usados apenas uma vez pelo "npm run seed-admin" para criar a conta admin.
# Depois de rodar o seed, pode apagar ou trocar estes valores - a senha
# fica salva com hash em data/admin.json, não em texto puro.
ADMIN_EMAIL=admin@eletricavallerini.com.br
ADMIN_PASSWORD=troque-esta-senha
